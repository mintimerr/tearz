{
  "name": "tearz-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "check:api": "node scripts/check-api-health.mjs",
    "deploy:render": "node scripts/deploy-render.mjs",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:play": "eas build --platform android --profile play",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest --profile production",
    "submit:android": "eas submit --platform android --latest --profile production",
    "submit:play": "eas submit --platform android --latest --profile play",
    "release:testflight": "node scripts/release-testflight.mjs",
    "release:api-url": "node scripts/release-testflight.mjs --no-build",
    "setup:testflight": "bash scripts/setup-testflight.sh",
    "finish:testflight": "bash scripts/finish-testflight.sh",
    "build:web": "node scripts/build-web.mjs",
    "finish:play": "bash scripts/finish-play.sh",
    "rive:refs": "python3 scripts/prepare-rive-board-refs.py",
    "rive:layers": "python3 scripts/prepare-rive-board-layers.py",
    "rive:import-pack": "python3 scripts/prepare-rive-import-pack.py",
    "rive:fast": "cat scripts/rive-board-fast.md",
    "rive:validate": "node scripts/validate-tearz-board-riv.mjs",
    "rive:validate:day1": "node scripts/validate-tearz-board-riv.mjs --phase=1",
    "rig:layers": "python3 scripts/prepare-tearz-board-rig-layers.py",
    "rig:sprites": "python3 scripts/prepare-tearz-board-sprites.py",
    "rig:sequences": "python3 scripts/prepare-tearz-board-sequences.py"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/kalam": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@rive-app/react-canvas": "^4.31.0",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "lottie-react-native": "~7.3.1",
    "pinyin-pro": "^3.28.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "rive-react-native": "^9.8.3",
    "tearz-exclusion-text": "file:modules/tearz-exclusion-text"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@rive-app/canvas-advanced-single": "^2.38.3",
    "@types/react": "~19.1.0",
    "eas-cli": "^20.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
