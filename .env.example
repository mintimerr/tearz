# Пример для Expo (корень проекта). Скопируйте в `.env` — файл в .gitignore.
#
# Локальная разработка:
#   iOS Simulator:     http://127.0.0.1:8787
#   Телефон (Expo Go): http://<IP-вашего-Mac>:8787  (тот же Wi‑Fi)
#
# TestFlight / EAS-сборка — задайте через EAS Secret (не в .env в репозитории):
#   eas secret:create --scope project --name EXPO_PUBLIC_COMPANION_CHAT_API_URL --value https://api.example.com
#
EXPO_PUBLIC_COMPANION_CHAT_API_URL=http://127.0.0.1:8787
