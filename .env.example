# Пример для Expo (корень проекта). Скопируйте в `.env` — файл в .gitignore.
#
# Локальная разработка:
#   iOS Simulator:     http://127.0.0.1:8787
#   Телефон (Expo Go): http://<IP-вашего-Mac>:8787  (тот же Wi‑Fi)
#
# Публичный релиз / EAS production — постоянный HTTPS (не ngrok), см. docs/PUBLIC_RELEASE.md:
#   eas env:create --name EXPO_PUBLIC_COMPANION_CHAT_API_URL --value https://tearz-chat-api.onrender.com --environment production
#   npm run check:api -- https://tearz-chat-api.onrender.com
#
# Legal (опционально; дефолт https://tearz.app/privacy|terms):
#   EXPO_PUBLIC_PRIVACY_URL=https://tearz.app/privacy
#   EXPO_PUBLIC_TERMS_URL=https://tearz.app/terms
#
EXPO_PUBLIC_COMPANION_CHAT_API_URL=http://127.0.0.1:8787
# EXPO_PUBLIC_PRIVACY_URL=https://tearz.app/privacy
# EXPO_PUBLIC_TERMS_URL=https://tearz.app/terms
