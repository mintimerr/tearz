{
  "expo": {
    "name": "Tearz",
    "slug": "tearz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tearzmobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2A78",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложение использует фото для аватара и вложений в чате.",
          "cameraPermission": "Камера нужна, чтобы сделать фото и прикрепить его к сообщению."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Доступ к галерее нужен, чтобы показывать недавние фото при отправке вложений.",
          "savePhotosPermission": "Разрешите сохранение фото при необходимости.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0B1430",
          "dark": {
            "backgroundColor": "#0B1430"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен, чтобы записывать голосовые сообщения собеседнику."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "014cc597-cda4-44b2-aef6-ca6b4a2ad33f"
      }
    }
  }
}
