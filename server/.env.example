# Скопируйте в server/.env и заполните значения.

OPENAI_API_KEY=sk-...
PORT=8787
NODE_ENV=production

# Модели (умные дефолты; переопределите при необходимости):
# TEACHER_MODEL=gpt-4.1              # уроки + drills + проверка
# TEACHER_FAST_MODEL=gpt-4.1-mini    # intent + push-copy
# COMPANION_MODEL=gpt-4.1            # чат с собеседником
# COMPANION_PROFILE_MODEL=gpt-4.1    # генерация persona
# COMPANION_REALTIME_MODEL=gpt-realtime-mini
# EXERCISE_IMAGE_MODEL=dall-e-2   # картинки для word_to_image (по смыслу слова)

# Письма с кодом регистрации (обязательно для TestFlight / реальных пользователей):
# 1. https://resend.com → API Keys → создать ключ
# 2. Вставить ниже. Без ключа код только в логе сервера (режим разработки).
RESEND_API_KEY=re_...
# На бесплатном плане без своего домена используйте onboarding@resend.dev —
# письма уходят только на email, с которым вы зарегистрировались в Resend.
AUTH_FROM_EMAIL=Tearz <onboarding@resend.dev>
